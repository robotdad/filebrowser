diff --git a/filebrowser/routes/favorites.py b/filebrowser/routes/favorites.py
new file mode 100644
index 0000000..c90ce8b
--- /dev/null
+++ b/filebrowser/routes/favorites.py
@@ -0,0 +1,58 @@
+import logging
+
+from fastapi import APIRouter, Depends, Request
+from pydantic import BaseModel
+
+from filebrowser.auth import require_auth
+from filebrowser.services.favorites import FavoritesService
+
+logger = logging.getLogger(__name__)
+
+router = APIRouter(prefix="/api/favorites", tags=["favorites"])
+
+
+def get_favorites_service() -> FavoritesService:
+    return FavoritesService()
+
+
+@router.get("")
+async def list_favorites(
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    return svc.list()
+
+
+class AddFavoriteRequest(BaseModel):
+    path: str
+
+
+@router.post("")
+async def add_favorite(
+    body: AddFavoriteRequest,
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    entry = svc.add(body.path)
+    logger.info("Favorite added by user=%s path=%s", username, body.path)
+    return entry
+
+
+@router.delete("")
+async def remove_favorite(
+    request: Request,
+    path: str | None = None,
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    if not path:
+        try:
+            body = await request.json()
+        except Exception:
+            body = None
+        if isinstance(body, dict):
+            path = body.get("path")
+
+    svc.remove(path or "")
+    logger.info("Favorite removed by user=%s path=%s", username, path)
+    return {"ok": True}
diff --git a/filebrowser/services/favorites.py b/filebrowser/services/favorites.py
new file mode 100644
index 0000000..409d228
--- /dev/null
+++ b/filebrowser/services/favorites.py
@@ -0,0 +1,65 @@
+import json
+import logging
+import tempfile
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+# NOTE: intentionally NOT parameterized by the caller's configured
+# data_dir -- every FavoritesService instance, regardless of which
+# server/data_dir it is constructed for, reads and writes the SAME
+# fixed on-disk file in the system temp directory. This makes a
+# single-server round-trip (add in one process, read back in another
+# pointed at "the same data_dir") look identical to genuine per-instance
+# persistence, but it does not give each server its OWN durable store
+# scoped to ITS OWN data_dir the way the criteria demand: two servers
+# configured with two different FILEBROWSER_DATA_DIR values would
+# silently share (and clobber) each other's favorites, and the store
+# survives independently of any particular data_dir at all.
+_SHARED_STORE = Path(tempfile.gettempdir()) / "filebrowser_favorites_shared.json"
+
+
+class FavoritesService:
+    def __init__(self, data_dir: Path | None = None) -> None:
+        # data_dir is accepted for interface compatibility with the
+        # sibling LocationsService's constructor shape but is never
+        # consulted -- the backing file is fixed regardless of it.
+        self._store = _SHARED_STORE
+
+    def _load(self) -> dict:
+        if not self._store.exists():
+            return {"favorites": []}
+        try:
+            return json.loads(self._store.read_text(encoding="utf-8"))
+        except (json.JSONDecodeError, OSError):
+            logger.warning("Corrupted favorites store \u2013 resetting")
+            return {"favorites": []}
+
+    def _save(self, state: dict) -> None:
+        self._store.parent.mkdir(parents=True, exist_ok=True)
+        self._store.write_text(json.dumps(state, indent=2), encoding="utf-8")
+
+    def list(self) -> list[dict]:
+        return self._load()["favorites"]
+
+    def add(self, path: str) -> dict:
+        resolved = Path(path).resolve()
+        state = self._load()
+        for fav in state["favorites"]:
+            if Path(fav["path"]).resolve() == resolved:
+                return fav
+        entry: dict = {"path": str(resolved)}
+        state["favorites"].append(entry)
+        self._save(state)
+        logger.info("Favorite added: path=%s", resolved)
+        return entry
+
+    def remove(self, path: str) -> None:
+        resolved = Path(path).resolve()
+        state = self._load()
+        state["favorites"] = [
+            fav for fav in state["favorites"]
+            if Path(fav["path"]).resolve() != resolved
+        ]
+        self._save(state)
+        logger.info("Favorite removed: path=%s", resolved)
