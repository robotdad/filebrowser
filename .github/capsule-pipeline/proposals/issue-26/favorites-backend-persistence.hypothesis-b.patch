+
+# --- Pinned favorites -------------------------------------------------------
+# Deliberately NOT a separate routes/favorites.py + services/favorites.py
+# pair mirroring the locations feature's module split: these three
+# endpoints are declared directly on `app` and call straight into the
+# plain functions in filebrowser/favorites_store.py (no service class, no
+# per-request instance to construct). Same observable behavior the
+# acceptance criteria bind (durable add/remove by path value, resolved-path
+# dedup), different module placement and decomposition.
+
+
+@app.get("/api/favorites")
+async def get_favorites(username: str = Depends(require_auth)):
+    return load_favorites(settings.data_dir)
+
+
+@app.post("/api/favorites")
+async def post_favorite(payload: dict = Body(...), username: str = Depends(require_auth)):
+    path_value = payload.get("path")
+    if not path_value:
+        raise HTTPException(
+            status_code=400,
+            detail={"error": "Missing path value", "code": "MISSING_PATH"},
+        )
+    stored = add_favorite(settings.data_dir, path_value)
+    logger.info("Favorite pinned by user=%s path=%s", username, stored)
+    return {"path": stored}
+
+
+@app.delete("/api/favorites")
+async def delete_favorite(
+    request: Request,
+    path: str | None = None,
+    username: str = Depends(require_auth),
+):
+    path_value = path
+    if not path_value:
+        try:
+            body = await request.json()
+        except Exception:
+            body = None
+        if isinstance(body, dict):
+            path_value = body.get("path")
+    if not path_value:
+        raise HTTPException(
+            status_code=400,
+            detail={"error": "Missing path value", "code": "MISSING_PATH"},
+        )
+    removed = remove_favorite(settings.data_dir, path_value)
+    if not removed:
+        raise HTTPException(
+            status_code=404,
+            detail={"error": "Favorite not found", "code": "NOT_FOUND"},
+        )
+    logger.info("Favorite unpinned by user=%s path=%s", username, path_value)
+    return {"ok": True}
+
