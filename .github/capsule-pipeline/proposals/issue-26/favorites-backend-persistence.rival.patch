index 0000000..7b194d5
--- /dev/null
+++ b/filebrowser/routes/favorites.py
@@ -0,0 +1,58 @@
+import logging
+
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+
+from filebrowser.auth import require_auth
+from filebrowser.config import settings
+from filebrowser.services.favorites import FavoritesService
+
+logger = logging.getLogger(__name__)
+
+router = APIRouter(prefix="/api/favorites", tags=["favorites"])
+
+
+def get_favorites_service() -> FavoritesService:
+    return FavoritesService(settings.data_dir)
+
+
+@router.get("")
+async def list_favorites(
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    return svc.list()
+
+
+class AddFavoriteRequest(BaseModel):
+    path: str
+
+
+@router.post("")
+async def add_favorite(
+    body: AddFavoriteRequest,
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    entry = svc.add(body.path)
+    logger.info("Favorite added by user=%s path=%s", username, body.path)
+    return entry
+
+
+@router.delete("")
+async def remove_favorite(
+    path: str,
+    username: str = Depends(require_auth),
+    svc: FavoritesService = Depends(get_favorites_service),
+):
+    # Delegated: the delete surface identifies a favorite by path value (AC-2);
+    # a query string parameter is the natural carrier for a path on a DELETE
+    # request without a body, mirroring how many REST APIs pass DELETE filters.
+    try:
+        svc.remove(path)
+    except KeyError as exc:
+        raise HTTPException(
+            status_code=404, detail={"error": str(exc), "code": "NOT_FOUND"}
+        )
+    logger.info("Favorite removed by user=%s path=%s", username, path)
+    return {"ok": True}
diff --git a/filebrowser/services/favorites.py b/filebrowser/services/favorites.py
new file mode 100644
index 0000000..f521422
--- /dev/null
+++ b/filebrowser/services/favorites.py
@@ -0,0 +1,62 @@
+import json
+import logging
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+_INITIAL_STATE: dict = {"favorites": []}
+
+
+class FavoritesService:
+    """On-disk persistence for pinned favorite folders, keyed by path value.
+
+    Mirrors the on-disk-store shape of LocationsService (filebrowser/services/locations.py)
+    but favorites are identified by their resolved path, not a numeric id (AC-2).
+    """
+
+    def __init__(self, data_dir: Path) -> None:
+        self._data_dir = data_dir
+        self._store = data_dir / "favorites.json"
+
+    def _load(self) -> dict:
+        if not self._store.exists():
+            return {"favorites": []}
+        try:
+            state = json.loads(self._store.read_text(encoding="utf-8"))
+        except (json.JSONDecodeError, OSError):
+            logger.warning("Corrupted favorites.json – resetting")
+            return {"favorites": []}
+        state.setdefault("favorites", [])
+        return state
+
+    def _save(self, state: dict) -> None:
+        self._data_dir.mkdir(parents=True, exist_ok=True)
+        self._store.write_text(json.dumps(state, indent=2), encoding="utf-8")
+
+    def list(self) -> list[dict]:
+        return [{"path": p} for p in self._load()["favorites"]]
+
+    def add(self, path: str) -> dict:
+        """Add a favorite by path. Idempotent on resolved/canonicalized equality (AC-3)."""
+        resolved = str(Path(path).resolve())
+        state = self._load()
+
+        # Deduplicate by resolved path — same rule as LocationsService.add,
+        # per AC-3's explicit pointer to Path(...).resolve() in locations.py.
+        if resolved not in state["favorites"]:
+            state["favorites"].append(resolved)
+            self._save(state)
+            logger.info("Favorite added: path=%s", resolved)
+        return {"path": resolved}
+
+    def remove(self, path: str) -> None:
+        """Remove a favorite identified by its path value (AC-2), matched by
+        resolved/canonicalized equality for consistency with add()'s dedup rule (AC-3)."""
+        resolved = str(Path(path).resolve())
+        state = self._load()
+        before = len(state["favorites"])
+        state["favorites"] = [p for p in state["favorites"] if p != resolved]
+        if len(state["favorites"]) == before:
+            raise KeyError(f"Favorite not found: {path}")
+        self._save(state)
+        logger.info("Favorite removed: path=%s", resolved)
